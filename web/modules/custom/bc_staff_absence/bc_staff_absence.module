<?php

/**
 * @file
 * Theme registrations for BC Staff Absence.
 */

/**
 * Implements hook_theme().
 */
function bc_staff_absence_theme(): array {
  return [
    'bc_staff_absence_dashboard' => [
      'variables' => [
        'heading' => '',
        'description' => '',
        'items' => [],
        'review' => FALSE,
        'add_url' => '',
      ],
      'template' => 'bc-staff-absence-dashboard',
    ],
    'bc_staff_absence_calendar' => [
      'variables' => [
        'dates' => [],
        'rows' => [],
        'period' => '',
        'mode' => 'week',
        'previous' => '',
        'next' => '',
        'week_url' => '',
        'month_url' => '',
        'today_url' => '',
        'filter_available' => FALSE,
        'departments' => [],
        'selected_department' => '',
        'filter_date' => '',
        'filter_url' => '',
      ],
      'template' => 'bc-staff-absence-calendar',
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function bc_staff_absence_page_attachments(array &$page): void {
  $route = Drupal::routeMatch()->getRouteName();
  if (in_array($route, ['bc_staff_absence.list', 'bc_staff_absence.review', 'bc_staff_absence.add'], TRUE)) {
    $page['#attached']['library'][] = 'bc_staff_absence/dashboard';
  }
  if ($route === 'bc_staff_absence.calendar') {
    $page['#attached']['library'][] = 'bc_staff_absence/calendar';
  }
}
