<section class="bc-notifications"><header><h2>{{ 'Notifikationer'|t }}</h2><p>{{ 'Beskeder om ferieansøgninger og godkendelser'|t }}</p></header><div class="bc-notifications__list">{% for item in items %}<a href="{{ item.url }}" class="bc-notifications__item{{ item.unread ? ' is-unread' : '' }}"><span>{{ item.message }}</span><small>{{ item.time }}</small></a>{% else %}<p>{{ 'Ingen notifikationer endnu.'|t }}</p>{% endfor %}</div></section>