<?php

/**
 * @file
 * Theme registration for BC Staff.
 */

/**
 * Implements hook_theme().
 */
function bc_staff_theme($existing, $type, $theme, $path): array {
  return [
    'bc_staff_dashboard' => [
      'variables' => [
        'staff' => [],
        'departments' => [],
        'avatar' => '',
        'status_url' => '',
        'demo_url' => '',
      ],
      'template' => 'bc-staff-dashboard',
    ],
  ];
}
