<?php

/**
 * @file
 * Theme registration for BC Staff.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\user\UserInterface;

/**
 * Implements hook_theme().
 */
function bc_staff_theme($existing, $type, $theme, $path): array {
  return [
    'bc_staff_employee_admin' => [
      'variables' => [
        'employees' => [],
        'departments' => [],
        'houses' => [],
        'workgroups' => [],
        'statuses' => [],
        'add_url' => '',
      ],
      'template' => 'bc-staff-employee-admin',
    ],
    'bc_staff_attendance_report' => [
      'variables' => ['entries' => [], 'from' => '', 'to' => '', 'employees' => 0, 'events' => 0],
      'template' => 'bc-staff-attendance-report',
    ],
    'bc_staff_attendance_history' => [
      'variables' => ['employees' => [], 'events' => []],
      'template' => 'bc-staff-attendance-history',
    ],
    'bc_staff_organization' => [
      'variables' => ['groups' => []],
      'template' => 'bc-staff-organization',
    ],
    'bc_staff_dashboard' => [
      'variables' => [
        'staff' => [],
        'departments' => [],
        'houses' => [],
        'workgroups' => [],
        'statuses' => [],
        'avatar' => '',
        'status_url' => '',
        'demo_url' => '',
        'employees_url' => '',
        'my_name' => '',
        'my_profile_url' => '',
      ],
      'template' => 'bc-staff-dashboard',
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function bc_staff_page_attachments(array &$page): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name && str_starts_with($route_name, 'bc_staff.')) {
    $page['#attached']['library'][] = 'bc_staff/staff_ui';
  }
  if (\Drupal::routeMatch()->getRouteName() === 'bc_staff.mobile') {
    $path = base_path() . \Drupal::service('extension.list.module')->getPath('bc_staff');
    $page['#attached']['html_head_link'][] = [
      ['rel' => 'manifest', 'href' => $path . '/assets/manifest.webmanifest'],
      TRUE,
    ];
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'theme-color', 'content' => '#164878'],
      ],
      'bc_staff_theme_color',
    ];
  }
}

/**
 * Implements hook_entity_view().
 *
 * Show BC Staff identity on the profile, not on the shared/public overview.
 */
function bc_staff_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if ($entity->getEntityTypeId() !== 'user') {
    return;
  }
  $viewer = \Drupal::currentUser();
  if ((int) $viewer->id() !== (int) $entity->id() && !$viewer->hasPermission('administer users')) {
    return;
  }
  if (!$entity->hasField('field_bc_staff_status')) {
    return;
  }
  $name = $entity->hasField('field_bc_staff_display_name') && !$entity->get('field_bc_staff_display_name')->isEmpty()
    ? $entity->get('field_bc_staff_display_name')->value
    : $entity->getDisplayName();
  $key = $entity->get('field_bc_staff_status')->value;
  $options = $entity->get('field_bc_staff_status')->getFieldDefinition()->getSetting('allowed_values');
  $build['bc_staff_identity'] = [
    '#type' => 'container',
    '#weight' => -30,
    '#attributes' => ['class' => ['bc-staff-profile']],
    'heading' => [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => Html::escape('BC Staff: ' . $name),
    ],
    'status' => [
      '#plain_text' => t('Status: @status', ['@status' => $options[$key] ?? t('Not specified')]),
    ],
    'location' => [
      '#markup' => '<p>' . t('Location: @location', [
        '@location' => $entity->get('field_bc_staff_location')->value ?: t('Not specified'),
      ]) . '</p>',
    ],
    '#cache' => ['contexts' => ['user'], 'tags' => $entity->getCacheTags()],
  ];
  if ((int) $viewer->id() === (int) $entity->id() && $viewer->hasPermission('update own bc staff status')) {
    $build['bc_staff_identity']['mobile'] = [
      '#type' => 'link',
      '#title' => t('Update my BC Staff status'),
      '#url' => Url::fromRoute('bc_staff.mobile'),
    ];
  }
}

/**
 * Implements hook_user_format_name_alter().
 *
 * Keep the login name unchanged; use the staff name for display everywhere.
 */
function bc_staff_user_format_name_alter(&$name, AccountInterface $account): void {
  // The current user session is not necessarily a full user entity.
  if (!$account instanceof UserInterface) {
    return;
  }
  if (!$account->hasField('field_bc_staff_display_name')) {
    return;
  }
  $value = trim((string) ($account->get('field_bc_staff_display_name')->value ?? ''));
  if ($value !== '') {
    $name = $value;
  }
}
