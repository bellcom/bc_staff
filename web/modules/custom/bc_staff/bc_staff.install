<?php

/**
 * @file
 * BC Staff database updates.
 */

/**
 * Create manageable staff locations.
 */
function bc_staff_update_11001(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  if (!$storage->load('bc_staff_location')) {
    $storage->create([
      'vid' => 'bc_staff_location',
      'name' => 'BC Staff locations',
      'description' => 'Locations available for employee status updates.',
    ])->save();
  }
}

/**
 * Ensure the BC Staff employee role exists on upgraded sites.
 */
function bc_staff_update_11002(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $role = $storage->load('bc_staff_employee');
  if (!$role) {
    $role = $storage->create([
      'id' => 'bc_staff_employee',
      'label' => 'BC Staff Employee',
    ]);
  }
  $role->grantPermission('view bc staff overview');
  $role->grantPermission('update own bc staff status');
  $role->save();
}

/**
 * Create scoped BC Staff administration roles for existing sites.
 */
function bc_staff_update_11003(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $roles = [
    'bc_staff_admin' => [
      'label' => 'BC Staff Administrator',
      'permissions' => ['view bc staff overview', 'update own bc staff status', 'administer bc staff employees'],
    ],
    'bc_staff_manager' => [
      'label' => 'BC Staff Manager',
      'permissions' => ['view bc staff overview', 'update own bc staff status', 'manage own bc staff department'],
    ],
  ];
  foreach ($roles as $id => $settings) {
    $role = $storage->load($id) ?: $storage->create(['id' => $id, 'label' => $settings['label']]);
    foreach ($settings['permissions'] as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}

/**
 * Install organizational vocabularies used by BC Staff.
 */
function bc_staff_update_11004(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  foreach ([
    'bc_staff_department' => 'BC Staff departments',
    'bc_staff_house' => 'BC Staff houses',
    'bc_staff_location' => 'BC Staff locations',
    'bc_staff_workgroup' => 'BC Staff workgroups',
  ] as $vid => $label) {
    if (!$storage->load($vid)) {
      $storage->create(['vid' => $vid, 'name' => $label])->save();
    }
  }
}

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Add employee house/workgroup and location department reference fields.
 */
function bc_staff_update_11005(): void {
  $storage = FieldStorageConfig::load('user.field_bc_staff_house');
  if (!$storage) {
    FieldStorageConfig::create([
      'field_name' => 'field_bc_staff_house',
      'entity_type' => 'user',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'taxonomy_term'],
      'cardinality' => 1,
    ])->save();
  }
  foreach ([
    'field_bc_staff_house' => ['House', 'bc_staff_house', 1],
    'field_bc_staff_workgroups' => ['Workgroups', 'bc_staff_workgroup', -1],
  ] as $field => [$label, $vid, $cardinality]) {
    if (!FieldStorageConfig::load('user.' . $field)) {
      FieldStorageConfig::create([
        'field_name' => $field,
        'entity_type' => 'user',
        'type' => 'entity_reference',
        'settings' => ['target_type' => 'taxonomy_term'],
        'cardinality' => $cardinality,
      ])->save();
    }
    if (!FieldConfig::load('user.user.' . $field)) {
      FieldConfig::create([
        'field_name' => $field,
        'entity_type' => 'user',
        'bundle' => 'user',
        'label' => $label,
        'settings' => ['handler' => 'default:taxonomy_term', 'handler_settings' => ['target_bundles' => [$vid => $vid]]],
      ])->save();
    }
  }
  if (!FieldStorageConfig::load('taxonomy_term.field_bc_staff_department')) {
    FieldStorageConfig::create([
      'field_name' => 'field_bc_staff_department',
      'entity_type' => 'taxonomy_term',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'taxonomy_term'],
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::load('taxonomy_term.bc_staff_location.field_bc_staff_department')) {
    FieldConfig::create([
      'field_name' => 'field_bc_staff_department',
      'entity_type' => 'taxonomy_term',
      'bundle' => 'bc_staff_location',
      'label' => 'Responsible department',
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => ['target_bundles' => ['bc_staff_department' => 'bc_staff_department']],
      ],
    ])->save();
  }
}
