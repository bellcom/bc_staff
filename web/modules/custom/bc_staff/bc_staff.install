<?php

/**
 * @file
 * BC Staff database updates.
 */

/**
 * Create manageable staff locations.
 */
function bc_staff_update_11001(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  if (!$storage->load('bc_staff_location')) {
    $storage->create([
      'vid' => 'bc_staff_location',
      'name' => 'BC Staff lokationer',
      'description' => 'Lokationer som kan vælges i medarbejdernes statusregistrering.',
    ])->save();
  }
}

/**
 * Ensure the BC Staff employee role exists on upgraded sites.
 */
function bc_staff_update_11002(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $role = $storage->load('bc_staff_employee');
  if (!$role) {
    $role = $storage->create([
      'id' => 'bc_staff_employee',
      'label' => 'BC Staff Medarbejder',
    ]);
  }
  $role->grantPermission('view bc staff overview');
  $role->grantPermission('update own bc staff status');
  $role->save();
}

/**
 * Create scoped BC Staff administration roles for existing sites.
 */
function bc_staff_update_11003(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  $roles = [
    'bc_staff_admin' => [
      'label' => 'BC Staff Administrator',
      'permissions' => ['view bc staff overview', 'update own bc staff status', 'administer bc staff employees'],
    ],
    'bc_staff_manager' => [
      'label' => 'BC Staff Leder',
      'permissions' => ['view bc staff overview', 'update own bc staff status', 'manage own bc staff department'],
    ],
  ];
  foreach ($roles as $id => $settings) {
    $role = $storage->load($id) ?: $storage->create(['id' => $id, 'label' => $settings['label']]);
    foreach ($settings['permissions'] as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}
