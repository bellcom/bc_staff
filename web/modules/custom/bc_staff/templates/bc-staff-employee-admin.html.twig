<section class="bc-employees" data-bc-employees><header class="bc-employees__header"><div><p class="bc-employees__eyebrow">{{ 'BC STAFF / ADMINISTRATION'|t }}</p><h2>{{ 'Employees'|t }}</h2><p>{{ 'Manage employee accounts, departments, houses and workgroups.'|t }}</p></div><a class="bc-employees__button" href="{{ add_url }}">{{ 'Add employee'|t }}</a></header><div class="bc-employees__toolbar"><label for="bc-employees-search">{{ 'Search'|t }}</label><input id="bc-employees-search" type="search" placeholder="{{ 'Name or login'|t }}" data-bc-employee-search><label for="bc-employees-department">{{ 'Department'|t }}</label><select id="bc-employees-department" data-bc-employee-department><option value="">{{ 'All departments'|t }}</option>{% for department in departments %}<option value="{{ department }}">{{ department }}</option>{% endfor %}</select><span data-bc-employee-count aria-live="polite"></span></div><div class="bc-employees__grid">{% for employee in employees %}<article class="bc-employees__card" data-bc-employee-card data-department="{{ employee.department }}" data-search="{{ (employee.name ~ ' ' ~ employee.login)|lower }}"><div class="bc-employees__card-title"><img class="bc-employees__avatar" src="{{ employee.photo_url }}" alt="" width="48" height="48" loading="lazy"><div><h3>{{ employee.name }}</h3><p>{{ employee.login }}</p></div><span class="bc-employees__status {{ employee.active ? 'is-active' : 'is-blocked' }}">{{ employee.active ? 'Active'|t : 'Blocked'|t }}</span></div><div class="bc-employees__details"><div><small>{{ 'Department'|t }}</small><strong>{{ employee.department }}</strong></div><div><small>{{ 'House'|t }}</small><strong>{{ employee.house ?: 'Not assigned'|t }}</strong></div>{% if employee.groups %}<div class="bc-employees__groups"><small>{{ 'Workgroups'|t }}</small><strong>{{ employee.groups|join(', ') }}</strong></div>{% endif %}</div><a class="bc-employees__edit" href="{{ employee.edit_url }}">{{ 'Edit employee'|t }}</a></article>{% else %}<p>{{ 'No employees.'|t }}</p>{% endfor %}</div><p class="bc-employees__empty" data-bc-employee-empty hidden>{{ 'No employees match these filters.'|t }}</p></section>
