<section class="bc-employees bc-directory-admin bc-attendance">
  <header class="bc-employees__header"><div><p class="bc-employees__eyebrow">BC STAFF / {{ 'ATTENDANCE'|t }}</p><h2>{{ 'Attendance report'|t }}</h2><p>{{ 'Daily and period attendance registrations.'|t }}</p></div></header>
  <form method="get" class="bc-attendance__report-filter">
    <label>{{ 'From date'|t }} <input type="date" name="from" value="{{ from }}" required></label>
    <label>{{ 'To date'|t }} <input type="date" name="to" value="{{ to }}" required></label>
    <button type="submit">{{ 'Show report'|t }}</button>
    <a href="{{ path('bc_staff.attendance_history') }}">{{ 'Attendance and history'|t }}</a>
  </form>
  <div class="bc-attendance__stats">
    <div><strong>{{ employees }}</strong><span>{{ 'Employees'|t }}</span></div>
    <div><strong>{{ entries|length }}</strong><span>{{ 'Employee days with registrations'|t }}</span></div>
    <div><strong>{{ events }}</strong><span>{{ 'Registrations in period'|t }}</span></div>
  </div>
  <div class="bc-attendance__events">
    <div class="bc-attendance__report-head"><span>{{ 'Employee'|t }}</span><span>{{ 'Date'|t }}</span><span>{{ 'First check-in'|t }}</span><span>{{ 'Last check-out'|t }}</span><span>{{ 'In / Out'|t }}</span></div>
    {% for item in entries %}
      <div class="bc-attendance__report-row"><strong>{{ item.name }}</strong><span>{{ item.date }}</span><span>{{ item.first ?: '—' }}</span><span>{{ item.last ?: '—' }}</span><span>{{ item['in'] }} / {{ item['out'] }}</span></div>
    {% else %}
      <p class="bc-attendance__empty">{{ 'No registrations during this period.'|t }}</p>
    {% endfor %}
  </div>
</section>