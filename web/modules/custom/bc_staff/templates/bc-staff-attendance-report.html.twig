<section class="bc-employees bc-directory-admin bc-attendance">
  <header class="bc-employees__header"><div><p class="bc-employees__eyebrow">BC STAFF / {{ 'ATTENDANCE'|t }}</p><h2>{{ 'Attendance report'|t }}</h2><p>{{ 'Daily and period attendance registrations.'|t }}</p></div></header>
  <form method="get" class="bc-attendance__report-filter" data-bc-attendance-report-filter>
    <label>{{ 'From date'|t }} <input type="date" name="from" value="{{ from }}" required></label>
    <label>{{ 'To date'|t }} <input type="date" name="to" value="{{ to }}" required></label>
    <a class="bc-attendance__export" data-bc-attendance-export href="{{ path('bc_staff.attendance_export', {}, {'query': {'from': from, 'to': to}}) }}">{{ 'Download CSV'|t }}</a>
    <a href="{{ path('bc_staff.attendance_history') }}">{{ 'Attendance and history'|t }}</a>
  </form>
  <div class="bc-attendance__stats">
    <div><strong>{{ employees }}</strong><span>{{ 'Employees'|t }}</span></div>
    <div><strong>{{ entries|length }}</strong><span>{{ 'Employee days with registrations'|t }}</span></div>
    <div><strong>{{ events }}</strong><span>{{ 'Registrations in period'|t }}</span></div>
  </div>
  <div class="bc-attendance__report-total">{{ 'Paired working hours'|t }}: <strong>{{ hours }}</strong></div>
  <div class="bc-attendance__events">
    <div class="bc-attendance__report-head"><span>{{ 'Employee'|t }}</span><span>{{ 'Date'|t }}</span><span>{{ 'First check-in'|t }}</span><span>{{ 'Last check-out'|t }}</span><span>{{ 'In / Out'|t }}</span><span>{{ 'Hours'|t }}</span><span>{{ 'Correction'|t }}</span></div>
    {% for item in entries %}
      <div class="bc-attendance__report-row"><strong class="bc-attendance__cell" data-label="{{ 'Employee'|t }}">{{ item.name }}</strong><span class="bc-attendance__cell" data-label="{{ 'Date'|t }}">{{ item.date }}</span><span class="bc-attendance__cell" data-label="{{ 'First check-in'|t }}">{{ item.first ?: '—' }}</span><span class="bc-attendance__cell" data-label="{{ 'Last check-out'|t }}">{{ item.last ?: '—' }}</span><span class="bc-attendance__cell" data-label="{{ 'In / Out'|t }}">{{ item['in'] }} / {{ item['out'] }}</span><span class="bc-attendance__cell" data-label="{{ 'Hours'|t }}">{{ item.duration }}{% if item.incomplete %} · {{ 'Incomplete'|t }}{% endif %}</span><span class="bc-attendance__cell bc-attendance__cell--actions" data-label="{{ 'Correction'|t }}">{% for link in item.correction_links %}<a href="{{ link.url }}">{{ link.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span></div>
    {% else %}
      <p class="bc-attendance__empty">{{ 'No registrations during this period.'|t }}</p>
    {% endfor %}
  </div>
</section>