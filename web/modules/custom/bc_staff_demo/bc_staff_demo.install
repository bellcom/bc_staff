<?php

/**
 * @file
 * Development-only demo data refresh updates.
 */

/**
 * Rebuilds illustrative absence scenarios for BC Staff demo accounts.
 */
function bc_staff_demo_update_11001(): string {
  if (!\Drupal::moduleHandler()->moduleExists('bc_staff_absence')) {
    return 'BC Staff Absence is not enabled; no absence data changed.';
  }

  $users = \Drupal::entityTypeManager()->getStorage('user');
  $db = \Drupal::database();
  $ids = $users->getQuery()
    ->accessCheck(FALSE)
    ->condition('uid', 0, '>')
    ->exists('field_bc_staff_demo')
    ->execute();

  $accounts = [];
  foreach ($users->loadMultiple($ids) as $account) {
    if ($account->hasField('field_bc_staff_demo')
      && (bool) $account->get('field_bc_staff_demo')->value
      && str_starts_with($account->getAccountName(), 'bc_demo_')) {
      $accounts[$account->getAccountName()] = (int) $account->id();
    }
  }
  if (!$accounts) {
    return 'No marked demo accounts found; no records changed.';
  }

  // Never delete the absence data belonging to ordinary employees.
  $db->delete('bc_staff_absence')
    ->condition('uid', array_values($accounts), 'IN')
    ->execute();

  $today = new \DateTimeImmutable('today');
  $date = static fn (int $offset): string => $today
    ->modify(sprintf('%+d days', $offset))
    ->format('Y-m-d');
  $suffixes = [
    ['manager_naestved', 'course', -2, 0, 'registered'],
    ['manager_roskilde', 'day_off', 3, 3, 'registered'],
    ['employee_naestved_1', 'vacation', -1, 3, 'approved'],
    ['employee_naestved_2', 'vacation', 1, 7, 'pending'],
    ['employee_naestved_3', 'vacation', -14, -10, 'rejected'],
    ['employee_naestved_1', 'sick', -17, -15, 'registered'],
    ['employee_naestved_2', 'child_sick', -9, -9, 'registered'],
    ['employee_naestved_3', 'course', 6, 7, 'registered'],
    ['employee_roskilde_1', 'vacation', 2, 6, 'pending'],
    ['employee_roskilde_2', 'vacation', -2, 1, 'approved'],
    ['employee_roskilde_3', 'vacation', -12, -8, 'rejected'],
    ['employee_roskilde_1', 'day_off', 9, 9, 'registered'],
    ['employee_roskilde_2', 'leave', 12, 14, 'registered'],
    ['employee_roskilde_3', 'sick', -5, -3, 'registered'],
  ];
  $created = 0;
  $now = \Drupal::time()->getRequestTime();
  foreach ($suffixes as [$suffix, $type, $from, $to, $state]) {
    $username = 'bc_demo_' . $suffix;
    if (!isset($accounts[$username])) {
      continue;
    }
    $db->insert('bc_staff_absence')->fields([
      'uid' => $accounts[$username],
      'type' => $type,
      'state' => $state,
      'start_date' => $date($from),
      'end_date' => $date($to),
      'created' => $now,
      'changed' => $now,
    ])->execute();
    $created++;
  }

  return "Refreshed {$created} demo absence scenarios for " . count($accounts) . ' fictional accounts.';
}

/**
 * Refreshes test scenarios for approved vacation workflow and attendance.
 *
 * This is intentionally destructive for marked fictional demo users only.
 */
function bc_staff_demo_update_11002(): string {
  $result = \Drupal\bc_staff_demo\Service\DemoScenarioRefresh::refresh();
  return sprintf('Demo refreshed: %d absences, %d change requests, %d attendance events.',
    $result['absences'], $result['changes'], $result['attendance']);
}

/**
 * Add a demonstration correction after the attendance audit table upgrade.
 */
function bc_staff_demo_update_11003(): string {
  $count = \Drupal\bc_staff_demo\Service\DemoAttendanceCorrectionSeeder::seed();
  return "Added {$count} demonstration attendance corrections.";
}

/**
 * Rebuild current demonstration attendance cases including forgotten check-outs.
 *
 * This deliberately resets only marked bc_demo_* accounts' demonstration data.
 */
function bc_staff_demo_update_11004(): string {
  $result = \Drupal\bc_staff_demo\Service\DemoScenarioRefresh::refresh();
  $corrections = \Drupal\bc_staff_demo\Service\DemoAttendanceCorrectionSeeder::seed();
  return sprintf('Demo reset: %d attendance events, %d absences, %d change requests, %d corrected check-outs.',
    $result['attendance'], $result['absences'], $result['changes'], $corrections);
}

/**
 * Populate the new in-app inbox for fictional demo accounts.
 */
function bc_staff_demo_update_11005(): string {
  $db = \Drupal::database();
  if (!$db->schema()->tableExists('bc_staff_notification')) {
    return 'Notifications are not installed.';
  }
  $users = \Drupal::entityTypeManager()->getStorage('user');
  $fixtures = [
    'bc_demo_manager_naestved' => ['Ny ferieansøgning', 'Ferieændring afventer godkendelse'],
    'bc_demo_manager_roskilde' => ['Ferieændring afventer godkendelse'],
    'bc_demo_employee_naestved_1' => ['Din ferieansøgning er godkendt'],
    'bc_demo_employee_roskilde_2' => ['Din ferieændring er afvist'],
  ];
  $created = 0;
  foreach ($fixtures as $username => $messages) {
    $matches = $users->loadByProperties(['name' => $username]);
    $account = reset($matches);
    if (!$account || !$account->hasField('field_bc_staff_demo') || !(bool) $account->get('field_bc_staff_demo')->value) {
      continue;
    }
    $db->delete('bc_staff_notification')->condition('uid', (int) $account->id())->execute();
    foreach ($messages as $message) {
      $db->insert('bc_staff_notification')->fields([
        'uid' => (int) $account->id(),
        'message' => $message,
        'target' => str_contains($username, 'manager') ? 'bc_staff_absence.review' : 'bc_staff_absence.list',
        'created' => \Drupal::time()->getCurrentTime(),
      ])->execute();
      $created++;
    }
  }
  return "Created {$created} fictional in-app notifications.";
}
