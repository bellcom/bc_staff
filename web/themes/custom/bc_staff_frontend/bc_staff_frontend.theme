<?php

/**
 * @file
 * Theme preprocessing for the BC Staff frontend.
 */

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_page().
 */
function bc_staff_frontend_preprocess_page(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $variables['bc_staff_panel'] = in_array($route, ['bc_staff.employee_edit', 'bc_staff.my_profile', 'bc_staff.kiosk'], TRUE)
    && \Drupal::request()->query->get('panel') === '1';
  $current_user = \Drupal::currentUser();
  $variables['bc_staff_user_name'] = $current_user->getDisplayName();
  $variables['bc_staff_user_login'] = '';
  $variables['bc_staff_user_role'] = '';
  $variables['bc_staff_user_department'] = '';
  if ($current_user->isAuthenticated()) {
    $account = \Drupal::entityTypeManager()->getStorage('user')->load($current_user->id());
    if ($account) {
      $variables['bc_staff_user_login'] = $account->getAccountName();
      $variables['bc_staff_user_name'] = $account->hasField('field_bc_staff_display_name')
        && !$account->get('field_bc_staff_display_name')->isEmpty()
        ? (string) $account->get('field_bc_staff_display_name')->value
        : $account->getDisplayName();
      $variables['bc_staff_user_role'] = $current_user->hasRole('bc_staff_admin')
        ? t('Administrator') : ($current_user->hasRole('bc_staff_manager')
          ? t('Manager') : t('Employee'));
      if ($account->hasField('field_bc_staff_department')
        && !$account->get('field_bc_staff_department')->isEmpty()) {
        $variables['bc_staff_user_department'] = $account->get('field_bc_staff_department')->entity?->label() ?? '';
      }
    }
  }
  $variables['bc_staff_notifications_enabled'] = \Drupal::moduleHandler()->moduleExists('bc_staff_absence');
  $variables['bc_staff_notification_count'] = 0;
  $variables['bc_staff_notification_preview'] = [];
  if ($current_user->isAuthenticated() && \Drupal::moduleHandler()->moduleExists('bc_staff_absence')
    && \Drupal::database()->schema()->tableExists('bc_staff_notification')) {
    $variables['bc_staff_notification_count'] = (int) \Drupal::database()->select('bc_staff_notification', 'n')
      ->condition('uid', (int) $current_user->id())->isNull('read_at')
      ->countQuery()->execute()->fetchField();
    $query = \Drupal::database()->select('bc_staff_notification', 'n');
    $records = $query->fields('n', ['id', 'message', 'created', 'read_at'])
      ->condition('uid', (int) $current_user->id())
      ->orderBy('created', 'DESC')->orderBy('id', 'DESC')->range(0, 5)->execute();
    foreach ($records as $record) {
      $variables['bc_staff_notification_preview'][] = [
        'message' => $record->message,
        'time' => \Drupal::service('date.formatter')->format((int) $record->created, 'short'),
        'unread' => $record->read_at === NULL,
        'url' => Url::fromRoute('bc_staff_absence.notification_open', ['notification' => $record->id])->toString(),
      ];
    }
  }
  $links = [
    'bc_staff.kiosk_admin' => t('Touch terminals'),
    'bc_staff.overview' => t('Overview'),
    'bc_staff.mobile' => t('My status'),
    'bc_staff.touch' => t('Check in / Check out'),
    'bc_staff.managed_touch' => t('Team check-in terminal'),
    'bc_staff.attendance_history' => t('Attendance and history'),
    'bc_staff.employee_list' => t('Employees'),
    'bc_staff.organization' => t('Organization'),
  ];
  if (\Drupal::moduleHandler()->moduleExists('bc_staff_absence')) {
    $links['bc_staff_absence.list'] = t('Absence');
    $links['bc_staff_absence.notifications'] = t('Notifikationer');
    $links['bc_staff_absence.review'] = t('Absence approvals');
    $links['bc_staff_absence.calendar'] = t('Team calendar');
  }
  if (\Drupal::currentUser()->isAnonymous()) {
    $links = ['bc_staff.login' => t('Sign in')];
  }

  $current = \Drupal::routeMatch()->getRouteName();
  $variables['bc_staff_navigation'] = [];
  foreach ($links as $route_name => $title) {
    $url = Url::fromRoute($route_name);
    if (!$url->access()) {
      continue;
    }
    $variables['bc_staff_navigation'][] = [
      'title' => $title,
      'url' => $url->toString(),
      'active' => $current === $route_name,
    ];
  }
}
