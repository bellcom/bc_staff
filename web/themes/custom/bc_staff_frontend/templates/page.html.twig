{# Dedicated BC Staff portal layout. #}
<div class="bc-app{{ bc_staff_panel ? ' bc-app--panel' : '' }}">
  <a class="bc-app__skip" href="#main-content">{{ 'Skip to main content'|t }}</a>
  {% if not bc_staff_panel %}
    <aside class="bc-app__sidebar">
      <a class="bc-app__sidebar-brand" href="{{ path('bc_staff.overview') }}"><span class="bc-app__sidebar-mark">BC</span><strong>BC Staff</strong></a>
      <nav class="bc-app__sidebar-nav" aria-label="{{ 'Staff navigation'|t }}">
        {% for item in bc_staff_navigation %}
          <a href="{{ item.url }}" class="{{ item.active ? 'is-active' : '' }}"{{ item.active ? ' aria-current="page"' : '' }}>{{ item.title }}</a>
        {% endfor %}
      </nav>
      <div class="bc-app__sidebar-bottom"><span>BC Staff</span></div>
    </aside>
    <header class="bc-app__header">
      <div class="bc-app__header-inner">
        <span class="bc-app__header-label">{{ 'Employee administration'|t }}</span>
        {% if bc_staff_user_login and not bc_staff_panel %}
          <a class="bc-app__notifications-link" href="{{ path('bc_staff_absence.notifications') }}" aria-label="{{ 'Notifikationer'|t }}" title="{{ 'Notifikationer'|t }}">
            <span aria-hidden="true">♧</span>
            {% if bc_staff_notification_count %}<span class="bc-app__notifications-count">{{ bc_staff_notification_count }}</span>{% endif %}
          </a>
        {% endif %}
        {% if bc_staff_user_login %}
          <a class="bc-app__user" href="{{ path('bc_staff.my_profile') }}" data-bc-self-profile aria-label="{{ 'My profile'|t }}">
            <span class="bc-app__user-avatar" aria-hidden="true">{{ bc_staff_user_name|first|upper }}</span>
            <span class="bc-app__user-details">
              <strong>{{ bc_staff_user_name }}</strong>
              <small>{{ bc_staff_user_role }}{% if bc_staff_user_department %} · {{ bc_staff_user_department }}{% endif %}</small>
              <small class="bc-app__user-login">{{ bc_staff_user_login }}</small>
            </span>
          </a>
        {% endif %}
      </div>
    </header>
    <div class="bc-directory-admin__shade" data-bc-self-shade hidden></div>
    <aside class="bc-directory-admin__drawer" data-bc-self-drawer hidden role="dialog" aria-modal="true" aria-label="{{ 'My profile'|t }}" tabindex="-1">
      <header><h2>{{ 'My profile'|t }}</h2><button type="button" data-bc-self-close aria-label="{{ 'Close'|t }}">×</button></header>
      <iframe data-bc-self-frame title="{{ 'My profile'|t }}"></iframe>
    </aside>
  {% endif %}
  <main id="main-content" class="bc-app__main">
    {% if page.highlighted %}<div class="bc-app__highlighted">{{ page.highlighted }}</div>{% endif %}
    {% if page.content %}{{ page.content }}{% endif %}
  </main>
</div>
